# Salin file ini menjadi .env di folder yang sama dengan app.py, lalu ganti semua nilai contoh.
# Jangan menyertakan .env saat mengumpulkan atau membagikan proyek.
APP_USER=admin
APP_PASS=ganti-dengan-password-kuat
SECRET_KEY=ganti-dengan-string-acak-panjang

# Analisis AI bersifat opsional. Tanpa kunci, aplikasi memakai aturan otomatis lokal.
GEMINI_API_KEY=isi_kunci_google_ai_studio_di_sini
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=isi_kunci_anthropic_jika_digunakan
